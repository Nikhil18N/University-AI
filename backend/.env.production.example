# ==============================================================================
# University AI Companion — Production Environment Template
# Used in Render / Hosted Cloud Deployments
# ==============================================================================

# ---- App Mode ----
APP_ENV=production
APP_DEBUG=false
CORS_ORIGINS=https://your-frontend.vercel.app

# ---- LLM Provider (Google Gemini with Multi-Key Pool) ----
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEYS=your_production_key_1,your_production_key_2
# Or single key:
# GEMINI_API_KEY=your_production_key_here

# ---- Embedding Provider ----
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# ---- Production Database (Neon / Render PostgreSQL) ----
DATABASE_URL=postgresql+asyncpg://username:password@ep-xyz.region.aws.neon.tech/university_ai?sslmode=require

# ---- Redis Cache (Upstash / Render Redis) ----
REDIS_URL=rediss://default:password@xyz.upstash.io:6379

# ---- Vector Storage (Embedded ChromaDB Persistent Directory or Cloud) ----
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_HOST=localhost
CHROMA_PORT=8000
RAG_MAX_DISTANCE=0.65

# ---- Admin Security ----
ADMIN_API_KEY=generate_a_secure_random_production_secret_here
