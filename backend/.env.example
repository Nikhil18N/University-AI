# ---- LLM (gemini, openrouter, or ollama) ----
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
# Single Gemini key (or use GEMINI_API_KEYS below):
GEMINI_API_KEY=your_gemini_api_key_here
# Multiple Gemini keys with automatic failover & quota rotation (comma-separated):
# GEMINI_API_KEYS=AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3...
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
OPENROUTER_API_KEY=

# ---- Embedding (gemini or ollama) ----
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://university_ai:university_ai_dev@localhost:5433/university_ai

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- ChromaDB ----
CHROMA_HOST=localhost
CHROMA_PORT=8000
# Optional: Set persistent folder for single-container/serverless deployments without a separate Chroma container:
# CHROMA_PERSIST_DIR=./chroma_data

# ---- Admin ----
ADMIN_API_KEY=change-me-in-production

# ---- App ----
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173
