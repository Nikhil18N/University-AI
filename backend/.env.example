# ---- LLM (gemini, openrouter, or ollama) ----
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
# Single Gemini key (or use GEMINI_API_KEYS below):
GEMINI_API_KEY=your_gemini_api_key_here
# Multiple Gemini keys with automatic failover & quota rotation (comma-separated):
# GEMINI_API_KEYS=AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3...
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
OPENROUTER_API_KEY=

# ---- Embedding (gemini or ollama) ----
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://university_ai:university_ai_dev@localhost:5433/university_ai
# Development-only fallback; production schemas must be managed with Alembic.
AUTO_CREATE_SCHEMA=false

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
# Increment after handbook or fee-source changes to rotate cached RAG answers.
RAG_CACHE_VERSION=1

# ---- ChromaDB ----
CHROMA_HOST=localhost
CHROMA_PORT=8000
# Optional: Set persistent folder for single-container/serverless deployments without a separate Chroma container:
# CHROMA_PERSIST_DIR=./chroma_data

# ---- Admin ----
ADMIN_API_KEY=change-me-in-production

# ---- App ----
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173
# Extra allowed browser origins as a pattern. The default allows localhost and any *.vercel.app site.
# In production you can narrow it to your own site, for example:
# CORS_ORIGIN_REGEX=^https://university-ai-companion(-[a-z0-9-]+)?\.vercel\.app$

# Show the "Early Bird 50% off" application card. Off until the admissions office confirms the offer
# for 2027-28; set to true only after it is confirmed in writing.
SHOW_EARLY_BIRD_OFFER=false

# ---- Admissions agent (app/sru_agent) ----
# The agent rotates through every key in GEMINI_API_KEYS. Use keys from SEPARATE Google Cloud
# projects: keys from the same project share one quota and add no capacity.
# How many model calls may run at the same moment (others wait their turn instead of failing):
AGENT_MAX_CONCURRENCY=6
# Seconds to wait before retrying a busy / rate-limited model call (v3.0.0: shorter, was 1.5,4,8):
AGENT_RETRY_DELAYS=1,2.5
AGENT_CALL_TIMEOUT=25
AGENT_TOTAL_TIMEOUT=45
# Seconds a rate-limited key is rested before it is used again:
AGENT_KEY_COOLDOWN_SECONDS=45
# Messages one student may send per minute:
AGENT_RATE_LIMIT_PER_MIN=20
# Shown to students in answers and links:
ADMISSIONS_PHONE=0870-2818333
ADMISSIONS_EMAIL=info@sru.edu.in
ADMISSIONS_WHATSAPP=918331003030
APPLY_URL=https://apply.sru.edu.in
ADMISSION_YEAR=2027-28
# A key that reached its PER-DAY limit is rested this many seconds before it is tried again:
AGENT_DAILY_LIMIT_COOLDOWN=3600
# The same first question from different students is answered from a saved copy for this many
# seconds (0 = off). Saves model calls on the suggestion buttons:
AGENT_ANSWER_CACHE_SECONDS=21600

# ---- Speed (v3.0.0) ----
# Least thinking the model allows: MINIMAL (LOW on models without MINIMAL). DEFAULT = the model's own.
AGENT_THINKING_LEVEL=MINIMAL
# Show the answer while Gemini is still writing it.
AGENT_STREAM=true
# Keep each student's profile / chat context in the server's memory and save to Redis and the
# database in the background. Right for ONE server process (the Dockerfile runs one). Set both to
# false if you ever run several processes (uvicorn --workers N) or several instances.
AGENT_LOCAL_CACHE=true
AGENT_BACKGROUND_WRITES=true

# ---- Campus visits and fee calculator (v3.0.0; defaults are the official sru.edu.in values) ----
# SRU Buddy never books or confirms a visit; it shares these and can pass on a callback request.
# CAMPUS_VISIT_PHONE=+91 70750 10336
# CAMPUS_VISIT_WHATSAPP=917075010336
# CAMPUS_VISIT_URL=https://sru.edu.in/visit-us
# FEE_PORTAL_URL=https://sru.edu.in/fee-scholarship/
