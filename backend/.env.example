# ---- LLM (gemini or ollama) ----
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
# If using Ollama:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2

# ---- Embedding (gemini or ollama) ----
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
# If using Ollama:
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://university_ai:university_ai_dev@localhost:5433/university_ai

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- ChromaDB ----
CHROMA_HOST=localhost
CHROMA_PORT=8000
# Optional: Set persistent folder for single-container/serverless deployments without a separate Chroma container:
# CHROMA_PERSIST_DIR=./chroma_data

# ---- Admin ----
ADMIN_API_KEY=change-me-in-production

# ---- App ----
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173
